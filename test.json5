              ],
            },
          },
        },
      },
    },
  },
  {
    name: "小蜜蜂影院",
    baseUrl: "https://www.xmfyy.cc",
    request: {
      method: "GET",
      headers: {
        "User-Agent": "Mozilla/5.0",
        "Accept-Language": "zh-CN,zh;q=0.9",
      },
      timeoutMs: 20000,
    },
    pages: {
      "ui.search": {
        list: {
          vars: {
            keyword: { fromInput: "keyword" },
            page: { init: 1 },
          },
          request: {
            url: "/index.php/vod/search/page/{{page}}/wd/{{keyword}}.html",
            method: "GET",
          },
          response: {
            format: "html",
            engine: "xpath",
            list: "//a[contains(@class,'hl-item-thumb') and contains(@href,'/index.php/vod/detail/')]",
            fields: {
              title: {
                first: [
                  "normalize-space(./@title)",
                  "normalize-space(.)",
                ],
              },
              detailUrl: {
                rule: "./@href",
                asUrl: true,
              },
              cover: {
                first: [
                  "./@data-original",
                  ".//img/@data-original",
                  ".//img/@data-src",
                  ".//img/@src",
                  "./@style",
                ],
                asUrl: true,
              },
              subtitle: "normalize-space((./following-sibling::div[1]//p[contains(@class,'hl-item-sub')][1]))",
              summary: "normalize-space((./following-sibling::div[1]//p[contains(@class,'hl-text-muted') or contains(@class,'hl-lc-2')][1]))",
            },
          },
          update: {
            page: { add: ["page", 1] },
          },
          open: "ui.detail",
        },
      },
      "ui.detail": {
        info: {
          request: {
            url: "{{ui.search.list.detailUrl}}",
            method: "GET",
          },
          response: {
            format: "html",
            engine: "xpath",
            item: "$",
            fields: {
              title: "normalize-space((.//h1 | .//h2[contains(@class,'hl-dc-title')] | .//*[contains(@class,'hl-mob-name')])[1])",
              subtitle: "normalize-space((.//*[contains(@class,'hl-dc-sub')][1]))",
              cover: {
                first: [
                  ".//div[contains(@class,'hl-dc-pic')]//*[contains(@class,'hl-item-thumb')]/@data-original",
                  ".//div[contains(@class,'hl-dc-pic')]//img/@data-original",
                  ".//div[contains(@class,'hl-dc-pic')]//img/@data-src",
                  ".//div[contains(@class,'hl-dc-pic')]//img/@src",
                  ".//*[contains(@class,'hl-detail-content')]//*[contains(@class,'hl-item-thumb')]/@data-original",
                ],
                asUrl: true,
              },
              summary: "normalize-space((.//span[contains(@class,'hl-content-text')] | .//li[contains(@class,'blurb')])[1])",
              playUrl: {
                rule: "(.//a[contains(@class,'hl-play-btn') and contains(@href,'/index.php/vod/play/')]/@href | .//div[contains(@class,'hl-tabs-box') and contains(@style,'display: block')][1]//ul[contains(@class,'hl-plays-list')]//a[contains(@href,'/index.php/vod/play/')]/@href | .//a[contains(@href,'/index.php/vod/play/')]/@href)[1]",
                asUrl: true,
              },
            },
          },
        },
        episodes: {
          request: {
            reuse: "info",
          },
          response: {
            format: "html",
            engine: "xpath",
            list: "(.//div[contains(@class,'hl-tabs-box') and contains(@style,'display: block')][1]//ul[contains(@class,'hl-plays-list')]//a[contains(@href,'/index.php/vod/play/')])[position() <= 200]",
            fields: {
              title: "normalize-space(.)",
              url: {
                rule: "./@href",
                asUrl: true,
              },
            },
          },
          fallbackItem: {
            title: "正片",
            url: "{{ui.detail.info.playUrl}}",
          },
          open: "ui.video.play",
        },
      },
      "ui.video.play": {
        content: {
          request: {
            url: "{{ui.detail.episodes.url}}",
            method: "GET",
          },
          response: {
            format: "html",
            engine: "xpath",
            item: "$",
            fields: {
              candidateUrl: {
                rule: "string(.)",
                regex: "\"url\"\\s*:\\s*\"(https?:\\\\?/\\\\?/[^\"<>]+?\\.(?:m3u8|mp4|mpd)(?:\\?[^\"<>]*)?)\"",
                asUrl: true,
              },
            },
          },
          output: {
            kind: "media",
            field: "candidateUrl",
            sniff: {
              include: [
                ".m3u8",
                ".mp4",
                ".mpd",
              ],
            },
          },
        },
      },
    },
  },
  {
    name: "AGE动漫",
    baseUrl: "https://www.agedm.io",
    request: {
      method: "GET",
      headers: {
        "User-Agent": "Mozilla/5.0",
        "Accept-Language": "zh-CN,zh;q=0.9",
        "Referer": "https://www.agedm.io/",
      },
      timeoutMs: 20000,
    },
    pages: {
      "ui.search": {
        list: {
          vars: {
            keyword: { fromInput: "keyword" },
            page: { init: 1 },
          },
          request: {
            url: "/search",
            method: "GET",
            query: {
              query: "{{keyword}}",
              page: "{{page}}",
            },
          },
          response: {
            format: "html",
            engine: "xpath",
            list: "//div[@id='cata_video_list']//div[contains(@class,'card') and contains(@class,'cata_video_item')][.//a[contains(@href,'/detail/')]]",
            fields: {
              title: "normalize-space((.//h5[contains(@class,'card-title')]//a[contains(@href,'/detail/')][1]))",
              detailUrl: {
                rule: "(.//h5[contains(@class,'card-title')]//a[contains(@href,'/detail/')]/@href | .//a[contains(@class,'d-block') and contains(@href,'/detail/')]/@href)[1]",
                asUrl: true,
              },
              cover: {
                first: [
                  ".//img[contains(@class,'video_thumbs')]/@data-original",
                  ".//img[contains(@class,'video_thumbs')]/@data-src",
                  ".//img[contains(@class,'video_thumbs')]/@src",
                ],
                asUrl: true,
              },
              subtitle: "normalize-space((.//*[contains(@class,'video_play_status')][1]))",
              summary: "normalize-space((.//div[contains(@class,'video_detail_info') and contains(@class,'desc')][1] | .//div[contains(@class,'video_detail_info')][contains(.,'播放状态')][1]))",
              playUrl: {
                rule: "(.//div[contains(@class,'video_btns')]//a[contains(@href,'/play/')]/@href)[1]",
                asUrl: true,
              },
            },
          },
          update: {
            page: { add: ["page", 1] },
          },
          open: "ui.detail",
        },
      },
      "ui.detail": {
        info: {
          request: {
            url: "{{ui.search.list.detailUrl}}",
            method: "GET",
          },
          response: {
            format: "html",
            engine: "xpath",
            item: "$",
            fields: {
              title: "normalize-space((.//h2[contains(@class,'video_detail_title')][1] | .//meta[@property='og:title']/@content)[1])",
              cover: {
                first: [
                  ".//div[contains(@class,'video_detail_cover')]//img/@data-original",
                  ".//div[contains(@class,'video_detail_cover')]//img/@data-src",
                  ".//meta[@property='og:image']/@content",
                  ".//div[contains(@class,'video_detail_cover')]//img/@src",
                ],
                asUrl: true,
              },
              summary: {
                first: [
                  "normalize-space((.//div[contains(@class,'video_detail_desc')][1]))",
                  "normalize-space((.//meta[@name='description']/@content)[1])",
                ],
              },
              subtitle: "normalize-space((.//li[.//span[contains(@class,'detail_imform_tag') and contains(.,'播放状态')]][1]))",
              playUrl: {
                rule: "(.//div[contains(@class,'tab-pane') and contains(@class,'show') and contains(@class,'active')][1]//a[contains(@class,'video_detail_spisode_link') and contains(@href,'/play/')]/@href | .//a[contains(@href,'/play/')]/@href)[1]",
                asUrl: true,
              },
            },
          },
        },
        episodes: {
          request: {
            reuse: "info",
          },
          response: {
            format: "html",
            engine: "xpath",
            list: "(.//div[contains(@class,'tab-pane') and contains(@class,'show') and contains(@class,'active')][1]//a[contains(@class,'video_detail_spisode_link') and contains(@href,'/play/')])[position() <= 200]",
            fields: {
              title: "normalize-space(.)",
              url: {
                rule: "./@href",
                asUrl: true,
              },
            },
          },
          fallbackItem: {
            title: "正片",
            url: "{{ui.detail.info.playUrl}}",
          },
          open: "ui.video.play",
        },
      },
      "ui.video.play": {
        content: {
          request: {
            url: "{{ui.detail.episodes.url}}",
            method: "GET",
            webView: {
              enabled: true,
              wait: {
                until: "networkIdle",
                timeoutMs: 15000,
              },
              extract: {
                type: "media",
                selector: "video, source, iframe",
                multiple: true,
              },
            },
          },
          response: {
            format: "html",
            engine: "xpath",
            item: "$",
            fields: {
              candidateUrl: {
                rule: "string(.)",
                regex: "(https?:\\\\?/\\\\?/[^\\s\"'<>]+?\\.(?:m3u8|mp4|mpd)(?:\\?[^\\s\"'<>]*)?)",
                asUrl: true,
              },
              pageUrl: {
                rule: "(.//link[@rel='canonical']/@href | .//meta[@property='og:url']/@content)[1]",
                asUrl: true,
              },
            },
          },
          output: {
            kind: "media",
            field: "candidateUrl",
            fallback: "pageUrl",
            sniff: {
              include: [
                ".m3u8",
                ".mp4",
                ".mpd",
              ],
            },
          },
        },
      },
    },
  },

  
  //sex
  {
    name: "xmjk",
    baseUrl: "https://s18.hdbjzs.com",
    pages: {
      "ui.search": {
        list: {
          vars: {
            keyword: {
              fromInput: "keyword",
            },
            page: {
              init: 1,
            },
          },
          request: {
            url: "https://xmjk.kphm88.com/forward",
            method: "POST",
            headers: {
              "Accept": "application/json, text/plain, */*",
              "Content-Type": "application/json",
              "User-Agent": "Mozilla/5.0",
            },
            bodyType: "json",
            charset: "UTF-8",
            timeoutMs: 15000,
            body: {
              command: "WEB_GET_INFO",
              pageNumber: "{{page}}",
              RecordsPage: "20",
              typeId: "0",
              typeMid: "1",
              languageType: "CN",
              content: "{{keyword}}",
              type: "1",
            },
          },
          response: {
            format: "json",
            engine: "jsonpath",
            list: "$.data.resultList[*]",
            fields: {
              id: "id",
              url: "id",
              typeMid: "type_Mid||typeMid",
              title: "vod_name",
              cover: {
                rule: "vod_pic",
                asUrl: true,
              },
              subtitle: "typeName||vod_class||vod_time_add",
            },
          },
          update: {
            page: {
              add: ["page", 1],
            },
          },
          open: "ui.video.play",
        },
      },
      "ui.video.play": {
        content: {
          request: {
            url: "https://xmjk.kphm88.com/forward",
            method: "POST",
            headers: {
              "Accept": "application/json, text/plain, */*",
              "Content-Type": "application/json",
              "User-Agent": "Mozilla/5.0",
            },
            bodyType: "json",
            charset: "UTF-8",
            timeoutMs: 15000,
            body: {
              command: "WEB_GET_INFO_DETAIL",
              type_Mid: "1",
              id: "{{input.url}}",
              languageType: "CN",
            },
          },
          response: {
            format: "json",
            engine: "jsonpath",
            item: "$.data.result",
