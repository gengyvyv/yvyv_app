// 来源：https://ailongmiao.com/movie/ 龙喵影视导航
// 逐个验证可播放的视频站点配置 (WebView 模式)
[
    {
    name: "omofun动漫视频网",
    baseUrl: "https://omofun01.top",
    pages: {
      "ui.search": {
        list: {
          vars: {
            keyword: {
              fromInput: "keyword",
            },
            page: {
              init: 1,
            },
          },
          request: {
            url: "/vod/search/page/{{page}}/wd/{{keyword}}.html",
            method: "GET",
            query: {},
            timeoutMs: 15000,
          },
          response: {
            format: "html",
            engine: "css",
            list: "div.module-main.module-page > div.module-items.module-card-items > div.module-card-item.module-item",
            fields: {
              title: "h1 a@text||h2 a@text||h3 a@text||h4 a@text||[class*=title] a@text||[class*=name] a@text||a[class*=title]@text||a[class*=name]@text||h1 a@title||h2 a@title||h3 a@title||h4 a@title||[class*=title] a@title||[class*=name] a@title||a[href*=voddetail]@title||a[href*=detail]@title||a[href*=video]@title||a[href*=movie]@title||a[href*=show]@title||img@alt",
              detailUrl: {
                rule: "h1 a@href||h2 a@href||h3 a@href||h4 a@href||[class*=title] a@href||[class*=name] a@href||a[class*=title]@href||a[class*=name]@href||a[href*=voddetail]@href||a[href*=detail]@href||a[href*=video]@href||a[href*=movie]@href||a[href*=show]@href",
                asUrl: true,
              },
              cover: {
                rule: "a.v-thumb@data-original||a.v-thumb@data-src||a.v-thumb@data-lazy-src||a.v-thumb@data-url||a.v-thumb@data-img||a.v-thumb@data-poster||img@data-original||img@data-src||img@data-lazy-src||img@data-url||img@data-img||img@data-poster||img@poster||img@src||[data-original]@data-original||[data-src]@data-src||[data-lazy-src]@data-lazy-src||[data-url]@data-url||[data-img]@data-img||[data-poster]@data-poster||[poster]@poster",
                asUrl: true,
              },
              summary: ".pic-text@text||.text-muted@text||p@text",
              playUrl: {
                rule: "a[href*=vodplay]@href||a[href*=play]@href||a[href*=player]@href||a[href*=watch]@href||a.btn-important@href||a.btn-base@href",
                asUrl: true,
              },
            },
          },
          open: "ui.detail",
        },
      },
      "ui.detail": {
        info: {
          request: {
            url: "{{ui.search.list.detailUrl}}",
            method: "GET",
            timeoutMs: 15000,
            webView: {
              enabled: true,
              wait: {
                until: "networkIdle",
                timeoutMs: 12000,
              },
            },
          },
          response: {
            format: "html",
            engine: "css",
            item: "$",
            fields: {
              title: "h1@text||.title@text",
              cover: {
                rule: "a.v-thumb@data-original||a.v-thumb@data-src||a.v-thumb@data-lazy-src||a.v-thumb@data-url||a.v-thumb@data-img||a.v-thumb@data-poster||img@data-original||img@data-src||img@data-lazy-src||img@data-url||img@data-img||img@data-poster||img@poster||img@src||[data-original]@data-original||[data-src]@data-src||[data-lazy-src]@data-lazy-src||[data-url]@data-url||[data-img]@data-img||[data-poster]@data-poster||[poster]@poster",
                asUrl: true,
              },
              summary: ".content@text||.vod-content@text||.detail-content@text",
              playUrl: {
                rule: "a[href*=vodplay]@href||a[href*=play]@href||a[href*=player]@href||a[href*=watch]@href||a.btn-important@href||a.btn-base@href",
                asUrl: true,
              },
            },
          },
        },
        episodes: {
          request: {
            reuse: "info",
          },
          response: {
            format: "html",
            engine: "css",
            list: "strong > div.main > div.content a[href*=vodplay], a[href*=play], a[href*=player], a[href*=watch], a[href*=episode], a[href*=ep-], a[href*=stream], [data-url*=vodplay], [data-url*=play], [data-url*=player], [data-url*=watch], [data-url*=episode], [data-url*=stream], [data-href*=vodplay], [data-href*=play], [data-href*=player], [data-href*=watch], [data-href*=episode], [data-href*=stream], [data-link*=vodplay], [data-link*=play], [data-link*=player], [data-link*=watch], [data-link*=episode], [data-link*=stream], [data-src*=vodplay], [data-src*=play], [data-src*=player], [data-src*=watch], [data-play*=vodplay], [data-play*=play], [data-value*=play], [onclick*=vodplay], [onclick*=play], [onclick*=player], [onclick*=watch], [onclick*=episode], [onclick*=stream]",
            fields: {
              title: "@text||@title||@aria-label",
              url: {
                first: [
                  {
                    rule: "@href",
                    asUrl: true,
                  },
                  {
                    rule: "@data-url",
                    asUrl: true,
                  },
                  {
                    rule: "@data-href",
                    asUrl: true,
                  },
                  {
                    rule: "@data-link",
                    asUrl: true,
                  },
                  {
                    rule: "@data-src",
                    asUrl: true,
                  },
                  {
                    rule: "@data-play",
                    asUrl: true,
                  },
                  {
                    rule: "@data-value",
                    asUrl: true,
                  },
                  {
                    rule: "@value",
                    asUrl: true,
                  },
                  {
                    rule: "@onclick",
                    regex: "['\\\"]([^'\\\"]*(?:vodplay|play|player|watch|episode|stream)[^'\\\"]*)['\\\"]",
                    asUrl: true,
                  },
                ],
              },
            },
          },
          fallbackItem: {
            title: "正片",
            url: "{{ui.detail.info.playUrl}}",
          },
        },
      },
      "ui.video.play": {
        content: {
          request: {
            url: "{{ui.detail.episodes.url}}",
            method: "GET",
            timeoutMs: 15000,
            webView: {
              enabled: true,
              wait: {
                until: "networkIdle",
                timeoutMs: 12000,
              },
            },
          },
          response: {
            format: "html",
            engine: "css",
            item: "$",
            fields: {
              candidateUrl: {
                first: [
                  {
                    rule: "@html",
                    regex: "https?://[^\\s\"'<>]+?\\.(?:m3u8|mp4)(?:\\?[^\\s\"'<>]*)?",
                    asUrl: true,
                  },
                  {
                    rule: "@html",
                    regex: "https?:\\\\\\/\\\\\\/[^\"'<>]+?\\.(?:m3u8|mp4)(?:\\?[^\"'<>]*)?",
                    asUrl: true,
                  },
                  {
                    rule: "@html",
                    regex: "url\\s*[:=]\\s*['\\\"]([^'\\\"]+\\.(?:m3u8|mp4)(?:\\?[^'\\\"]*)?)['\\\"]",
                    asUrl: true,
                  },
                  {
                    rule: "video@src||source@src",
                    asUrl: true,
                  },
                ],
              },
            },
          },
          output: {
            kind: "media",
            field: "candidateUrl",
            sniff: {
              include: [
                ".m3u8",
                ".mp4",
              ],
              exclude: [
                "ads",
                ".jpg",
                ".jpeg",
                ".png",
                ".gif",
                ".webp",
                ".avif",
                ".svg",
                ".bmp",
                ".ico",
                ".apng",
                ".heic",
                ".heif",
                ".tif",
                ".tiff",
                "image/",
                "format=webp",
                "format=avif",
              ],
            },
          },
        },
      },
    },
  },
]
