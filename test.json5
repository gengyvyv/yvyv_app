                rule: ".//a[contains(@href, 'play')]/@href",
                asUrl: true,
              },
            },
          },
        },
        episodes: {
          request: {
            reuse: "info",
          },
          response: {
            format: "html",
            engine: "xpath",
            list: "//main[contains(@class, 'wrapper')]/div[contains(@class, 'content')]//*[@id='play-list']/*[@id='source-bfzym3u8']/a[contains(@class, 'btn')][contains(@class, 'btn-default')]",
            fields: {
              title: "normalize-space(.)",
              url: {
                rule: "./@href",
                asUrl: true,
              },
            },
          },
          fallbackItem: {
            title: "正片",
            url: "{{ui.detail.info.playUrl}}",
          },
        },
      },
      "ui.video.play": {
        content: {
          request: {
            url: "{{ui.detail.episodes.url}}",
            method: "GET",
            timeoutMs: 15000,
            webView: {
              enabled: true,
              wait: {
                until: "networkIdle",
                timeoutMs: 12000,
              },
            },
          },
          response: {
            format: "html",
            engine: "xpath",
            item: "$",
            fields: {
              candidateUrl: {
                rule: "string(.)",
                regex: "https?://[^\\s\"'<>]+?\\.(?:m3u8|mp4)(?:\\?[^\\s\"'<>]*)?",
                asUrl: true,
              },
            },
          },
          output: {
            kind: "media",
            field: "candidateUrl",
            sniff: {
