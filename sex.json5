[
    {
      "name": "杏吧资源站",
      "baseUrl": "https://json.xingba222.com",
      "request": {
        "headers": {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        }
      },
      "pages": {
        "ui.search": {
          "list": {
            "vars": {
              "keyword": {
                "fromInput": "keyword"
              },
              "page": {
                "init": 1
              }
            },
            "request": {
              "url": "/api.php/provide/vod/",
              "method": "GET",
              "query": {
                "ac": "detail",
                "wd": "{{keyword}}",
                "pg": "{{page}}"
              }
            },
            "response": {
              "format": "json",
              "engine": "jsonpath",
              "list": "$.list[*]",
              "fields": {
                "id": "vod_id",
                "title": "vod_name",
                "cover": "vod_pic",
                "subtitle": "vod_remarks",
                "category": "type_name"
              }
            },
            "update": {
              "page": {
                "add": [
                  "page",
                  1
                ]
              }
            },
            "open": "ui.detail"
          }
        },
        "ui.detail": {
          "info": {
            "request": {
              "url": "/api.php/provide/vod/",
              "method": "GET",
              "query": {
                "ac": "detail",
                "ids": "{{ui.search.list.id}}"
              }
            },
            "response": {
              "format": "json",
              "engine": "jsonpath",
              "item": "$.list[0]",
              "fields": {
                "title": "vod_name",
                "cover": "vod_pic",
                "category": "type_name",
                "year": "vod_year",
                "area": "vod_area",
                "director": "vod_director",
                "actor": "vod_actor",
                "summary": "vod_content",
                "subtitle": "vod_remarks"
              }
            }
          },
          "episodes": {
            "request": {
              "reuse": "info"
            },
            "response": {
              "format": "json",
              "engine": "embeddedPlaylist",
              "item": "$.list[0]",
              "lineField": "vod_play_from",
              "itemsField": "vod_play_url",
              "lineSplit": "$$$",
              "itemSplit": "#",
              "pairRegex": "([^$#]+)\\$([^$#]+)",
              "fields": {
                "title": "itemName",
                "url": "itemUrl"
              }
            }
          }
        },
        "ui.video.play": {
          "content": {
            "response": {
              "format": "text"
            },
            "output": {
              "kind": "media",
              "field": "{{ui.detail.episodes.url}}"
            }
          }
        }
      }
    },
    {
      "name": "黄色仓库",
      "baseUrl": "https://hsckzy001.com",
      "request": {
        "headers": {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        }
      },
      "pages": {
        "ui.search": {
          "list": {
            "vars": {
              "keyword": {
                "fromInput": "keyword"
              },
              "page": {
                "init": 1
              }
            },
            "request": {
              "url": "/api.php/provide/vod/at/xml",
              "method": "GET",
              "query": {
                "ac": "detail",
                "wd": "{{keyword}}",
                "pg": "{{page}}"
              }
            },
            "response": {
              "xmlMode": "toObject",
              "format": "xml",
              "engine": "jsonpath",
              "list": "$.list.video[*]",
              "fields": {
                "id": "id",
                "title": "name",
                "cover": "pic",
                "subtitle": "note",
                "category": "type"
              }
            },
            "update": {
              "page": {
                "add": [
                  "page",
                  1
                ]
              }
            },
            "open": "ui.detail"
          }
        },
        "ui.detail": {
          "info": {
            "request": {
              "url": "/api.php/provide/vod/at/xml",
              "method": "GET",
              "query": {
                "ac": "detail",
                "ids": "{{ui.search.list.id}}"
              }
            },
            "response": {
              "xmlMode": "toObject",
              "format": "xml",
              "engine": "jsonpath",
              "item": "$.list.video[0]||$.list.video",
              "fields": {
                "title": "name",
                "cover": "pic",
                "category": "type",
                "year": "year",
                "area": "area",
                "director": "director",
                "actor": "actor",
                "summary": "des",
                "subtitle": "note"
              }
            }
          },
          "episodes": {
            "request": {
              "reuse": "info"
            },
            "response": {
              "xmlMode": "toObject",
              "format": "xml",
              "engine": "embeddedPlaylist",
              "lineField": "_play_from",
              "itemsField": "_play_url",
              "lineSplit": "$$$",
              "itemSplit": "#",
              "pairRegex": "([^$#]+)\\$([^$#]+)",
              "fields": {
                "title": "itemName",
                "url": "itemUrl"
              }
            }
          }
        },
        "ui.video.play": {
          "content": {
            "response": {
              "format": "text"
            },
            "output": {
              "kind": "media",
              "field": "{{ui.detail.episodes.url}}"
            }
          }
        }
      }
    },
