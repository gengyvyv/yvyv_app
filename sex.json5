    {
      "name": "xHamster",
      "baseUrl": "https://xhamster.com",
      "request": {
        "method": "GET",
        "headers": {
          "User-Agent": "Mozilla/5.0 (Linux; Android 14; Pixel 8) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Mobile Safari/537.36",
          "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
          "Accept-Language": "en-US,en;q=0.9"
        },
        "charset": "UTF-8",
        "timeoutMs": 20000
      },
      "pages": {
        "ui.search": {
          "list": {
            "vars": {
              "keyword": {
                "fromInput": "keyword"
              },
              "page": {
                "init": 1
              }
            },
            "request": {
              "url": "/search/{{keyword}}",
              "method": "GET",
              "query": {
                "page": "{{page}}"
              }
            },
            "response": {
              "format": "html",
              "engine": "css",
              "list": "article:has(a[href*='/videos/']), div[data-video-id], div[data-role*='video']:has(a[href*='/videos/']), a[href*='/videos/']",
              "fields": {
                "title": "a[href*='/videos/']@title||a[href*='/videos/']@aria-label||img@alt||@title||@aria-label||@text",
                "detailUrl": {
                  "rule": "a[href*='/videos/']@href||@href",
                  "asUrl": true
                },
                "cover": {
                  "rule": "img@data-src||img@data-r-src||img@data-preview||img@src",
                  "asUrl": true
                },
                "subtitle": ".duration@text||[class*='duration']@text||[data-role*='duration']@text",
                "summary": ".video-description@text||[class*='description']@text"
              }
            },
            "update": {
              "page": {
                "add": [
                  "page",
                  1
                ]
              }
            },
            "open": "ui.detail"
          }
        },
        "ui.detail": {
          "info": {
            "request": {
              "url": "{{ui.search.list.detailUrl}}",
              "method": "GET"
            },
            "response": {
              "format": "html",
              "engine": "css",
              "item": "$",
              "fields": {
                "title": "h1@text||meta[property=og:title]@content||title@text",
                "cover": {
                  "rule": "meta[property=og:image]@content||video@poster||img@data-src||img@src",
                  "asUrl": true
                },
                "summary": "meta[name=description]@content||meta[property=og:description]@content||[class*='description']@text",
                "subtitle": "[class*='views']@text||[class*='duration']@text",
                "playEntryUrl": {
                  "rule": "link[rel=canonical]@href||meta[property=og:url]@content",
                  "asUrl": true
                },
                "tags": {
                  "list": "a[href*='/tags/'], a[href*='/categories/']",
                  "fields": {
                    "title": "@text",
                    "url": {
                      "rule": "@href",
                      "asUrl": true
                    },
                    "keyword": "@text"
                  }
                }
              }
            }
          },
          "episodes": {
            "request": {
              "reuse": "info"
            },
            "response": {
              "format": "html",
              "engine": "css",
              "list": ".xh-unified-no-episode-list",
              "fields": {
                "title": "a@text",
                "url": {
                  "rule": "a@href",
                  "asUrl": true
                }
              }
            },
            "fallbackItem": {
              "title": "{{ui.detail.info.title}}",
              "url": "{{ui.search.list.detailUrl}}",
              "open": "ui.video.play"
            },
            "open": "ui.video.play"
          },
          "recommend": {
            "request": {
              "reuse": "info"
            },
            "response": {
              "format": "html",
              "engine": "css",
              "list": "article:has(a[href*='/videos/']), div[data-video-id], div[data-role*='video']:has(a[href*='/videos/']), a[href*='/videos/']",
              "fields": {
                "title": "a[href*='/videos/']@title||a[href*='/videos/']@aria-label||img@alt||@title||@aria-label||@text",
                "detailUrl": {
                  "rule": "a[href*='/videos/']@href||@href",
                  "asUrl": true
                },
                "cover": {
                  "rule": "img@data-src||img@data-r-src||img@data-preview||img@src",
                  "asUrl": true
                }
              }
            },
            "open": "ui.detail"
          }
        },
        "ui.video.play": {
          "content": {
            "request": {
              "url": "{{ui.detail.episodes.url}}",
              "method": "GET",
              "webView": {
                "enabled": true,
                "wait": {
                  "until": "selector",
                  "selector": "video, source, iframe, [data-role*='player'], [class*='player']",
                  "timeoutMs": 20000
                },
                "trigger": {
                  "type": "click",
                  "selector": "video, button[aria-label*='Play'], button[class*='play'], [data-role*='play']",
                  "delayMs": 1200,
                  "maxRounds": 1
                },
                "extract": {
                  "type": "media",
                  "selector": "video, video source, source, iframe, a[href*='.m3u8'], a[href*='.mp4']",
                  "multiple": true
                }
              }
            },
            "response": {
              "format": "html",
              "engine": "css",
              "item": "$",
              "fields": {
                "candidateUrl": {
                  "rule": "video@src||video source@src||source@src||iframe@src||a[href*='.m3u8']@href||a[href*='.mp4']@href",
                  "asUrl": true
                }
              }
            },
            "output": {
              "kind": "media",
              "field": "candidateUrl",
              "fallback": "{{ui.detail.episodes.url}}",
              "sniff": {
                "include": [
                  ".m3u8",
                  ".mp4",
                  "master.m3u8",
                  "hls"
                ],
                "exclude": [
                  "google-analytics.com",
                  "googletagmanager.com",
                  "trafficstars.com",
                  "tsyndicate.com",
                  "collector.xhamster.com",
                  "static-ah.xhcdn.com"
                ]
              }
            }
          }
        }
      }
    },
    {
    name: "xmjk",
    baseUrl: "https://s18.hdbjzs.com",
    pages: {
      "ui.search": {
        list: {
          vars: {
            keyword: {
              fromInput: "keyword",
            },
            page: {
              init: 1,
            },
          },
          request: {
            url: "https://xmjk.kphm88.com/forward",
            method: "POST",
            headers: {
              "Accept": "application/json, text/plain, */*",
              "Content-Type": "application/json",
              "User-Agent": "Mozilla/5.0",
            },
            bodyType: "json",
            charset: "UTF-8",
            timeoutMs: 15000,
            body: {
              command: "WEB_GET_INFO",
              pageNumber: "{{page}}",
              RecordsPage: "20",
              typeId: "0",
              typeMid: "1",
              languageType: "CN",
              content: "{{keyword}}",
              type: "1",
            },
          },
          response: {
            format: "json",
            engine: "jsonpath",
            list: "$.data.resultList[*]",
            fields: {
              id: "id",
              url: "id",
              typeMid: "type_Mid||typeMid",
              title: "vod_name",
              cover: {
                rule: "vod_pic",
                asUrl: true,
              },
              subtitle: "typeName||vod_class||vod_time_add",
            },
          },
          update: {
            page: {
              add: ["page", 1],
            },
          },
          open: "ui.video.play",
        },
      },
      "ui.video.play": {
        content: {
          request: {
            url: "https://xmjk.kphm88.com/forward",
            method: "POST",
            headers: {
              "Accept": "application/json, text/plain, */*",
              "Content-Type": "application/json",
              "User-Agent": "Mozilla/5.0",
            },
            bodyType: "json",
            charset: "UTF-8",
            timeoutMs: 15000,
            body: {
              command: "WEB_GET_INFO_DETAIL",
              type_Mid: "1",
              id: "{{input.url}}",
              languageType: "CN",
            },
          },
          response: {
            format: "json",
            engine: "jsonpath",
            item: "$.data.result",
            fields: {
              candidateUrl: {
                rule: "vod_url",
                asUrl: true,
              },
            },
          },
          output: {
            kind: "media",
            field: "candidateUrl",
          },
        },
      },
    },
  },

]
