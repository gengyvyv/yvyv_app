      {
    name: "华人影院",
    baseUrl: "https://huarw.com",
    request: {
      method: "GET",
      headers: {
        "User-Agent": "Mozilla/5.0",
        "Accept-Language": "zh-CN,zh;q=0.9",
      },
      timeoutMs: 15000,
    },
    pages: {
      "ui.search": {
        list: {
          vars: {
            keyword: {
              fromInput: "keyword",
            },
            page: {
              init: 1,
            },
          },
          request: {
            url: "/search/page/{{page}}/wd/{{keyword}}",
            method: "GET",
          },
          response: {
            format: "html",
            engine: "xpath",
            list: "//div[contains(@class,'public-list-box') and contains(@class,'search-box')][.//a[contains(@href,'/movie/')]]",
            fields: {
              title: "normalize-space((.//h3//a[contains(@href,'/movie/')][1]))",
              detailUrl: {
                rule: "(.//h3//a[contains(@href,'/movie/')]/@href | .//a[contains(@class,'public-list-exp') and contains(@href,'/movie/')]/@href)[1]",
                asUrl: true,
              },
              cover: {
                first: [
                  ".//img/@data-src",
                  ".//img/@data-original",
                  ".//img/@src",
                  ".//div[contains(@class,'cover')]/@style",
                ],
                asUrl: true,
              },
              subtitle: "normalize-space((.//*[contains(@class,'public-list-prb')][1]))",
              summary: "normalize-space((.//*[contains(@class,'thumb-blurb') or contains(@class,'thumb-actor') or contains(@class,'thumb-director')][1]))",
            },
          },
          update: {
            page: {
              add: [
                "page",
                1,
              ],
            },
          },
          open: "ui.detail",
        },
      },
      "ui.detail": {
        info: {
          request: {
            url: "{{ui.search.list.detailUrl}}",
            method: "GET",
          },
          response: {
            format: "html",
            engine: "xpath",
            item: "$",
            fields: {
              title: "normalize-space((.//h1[contains(@class,'seo-h1')][1] | .//*[contains(@class,'this-name')][1]))",
              cover: {
                first: [
                  ".//div[contains(@class,'slide-time-img2')]//img/@src",
                  ".//img[contains(@class,'gen-movie-img')]/@data-src",
                  ".//img/@data-src",
                  ".//img/@src",
                ],
                asUrl: true,
              },
              summary: "normalize-space((.//*[contains(@class,'sqjj_a') or contains(@class,'vod-content') or contains(@class,'details-content')][1]))",
              playUrl: {
                rule: "(.//ul[contains(@class,'anthology-list-play')]//a[contains(@href,'/play/')]/@href)[1]",
                asUrl: true,
              },
            },
          },
        },
        episodes: {
          request: {
            reuse: "info",
          },
          response: {
            format: "html",
            engine: "xpath",
            list: "(//div[contains(@class,'anthology-list-box')][1]//ul[contains(@class,'anthology-list-play')]//a[contains(@href,'/play/')])",
            fields: {
              title: "normalize-space(.)",
              url: {
                rule: "./@href",
                asUrl: true,
              },
            },
          },
          fallbackItem: {
            title: "正片",
            url: "{{ui.detail.info.playUrl}}",
          },
        },
      },
      "ui.video.play": {
        content: {
          request: {
            url: "{{ui.detail.episodes.url}}",
            method: "GET",
          },
          response: {
            format: "html",
            engine: "xpath",
            item: "$",
            fields: {
              candidateUrl: {
                rule: "string(.)",
                regex: "\"url\"\\s*:\\s*\"(https?:\\\\?/\\\\?/[^\"<>]+?\\.(?:m3u8|mp4|mpd)(?:\\?[^\"<>]*)?)\"",
                asUrl: true,
              },
            },
          },
          output: {
            kind: "media",
            field: "candidateUrl",
            sniff: {
              include: [
                ".m3u8",
                ".mp4",
                ".mpd",
              ],
            },
          },
        },
      },
    },
  },
  {
    name: "omofun动漫视频网",
    baseUrl: "https://omofun01.top",
    pages: {
      "ui.search": {
        list: {
          vars: {
            keyword: {
              fromInput: "keyword",
            },
            page: {
              init: 1,
            },
          },
          request: {
            url: "/vod/search/page/{{page}}/wd/{{keyword}}.html",
            method: "GET",
            query: {},
            timeoutMs: 15000,
          },
          response: {
            format: "html",
            engine: "css",
            list: "div.module-main.module-page > div.module-items.module-card-items > div.module-card-item.module-item",
            fields: {
              title: "div.module-card-item-info > div.module-card-item-title@text",
              detailUrl: {
                rule: "div.module-card-item-info > div.module-card-item-title > a@href",
                asUrl: true,
              },
              cover: {
                rule: "a.module-card-item-poster > div.module-item-cover > div.module-item-pic > img.lazy.lazyload@data-original",
                asUrl: true,
              },
              summary: "@text",
              playUrl: {
                rule: "a[href*=play]@href",
                asUrl: true,
              },
            },
          },
          open: "ui.detail",
        },
      },
      "ui.detail": {
        info: {
          request: {
            url: "{{ui.search.list.detailUrl}}",
            method: "GET",
            timeoutMs: 15000,
            webView: {
              enabled: true,
              wait: {
                until: "networkIdle",
                timeoutMs: 12000,
              },
            },
          },
          response: {
            format: "html",
            engine: "css",
            item: "$",
            fields: {
              title: "h1@text",
              cover: {
                rule: "img@src",
                asUrl: true,
              },
              summary: "@text",
              playUrl: {
                rule: "a[href*=play]@href",
                asUrl: true,
              },
            },
          },
        },
        episodes: {
          request: {
            reuse: "info",
          },
          response: {
            format: "html",
            engine: "css",
            list: "div.main > div.content > div.module #panel1 > div.module-play-list > div.module-play-list-content.module-play-list-base > a.module-play-list-link",
            fields: {
              title: "@text",
              url: {
                rule: "@href",
                asUrl: true,
              },
            },
          },
          fallbackItem: {
            title: "正片",
            url: "{{ui.detail.info.playUrl}}",
          },
        },
      },
      "ui.video.play": {
        content: {
          request: {
            url: "{{ui.detail.episodes.url}}",
            method: "GET",
            timeoutMs: 15000,
            webView: {
              enabled: true,
              wait: {
                until: "networkIdle",
                timeoutMs: 12000,
              },
            },
          },
          response: {
            format: "html",
            engine: "css",
            item: "$",
            fields: {
              candidateUrl: {
                rule: "@html",
                regex: "https?://[^\\s\"'<>]+?\\.(?:m3u8|mp4)(?:\\?[^\\s\"'<>]*)?",
                asUrl: true,
              },
            },
          },
          output: {
            kind: "media",
            field: "candidateUrl",
            sniff: {
              include: [
                ".m3u8",
                ".mp4",
              ],
            },
          },
        },
      },
    },
  },
