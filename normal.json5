                "init": 1
              }
            },
            "request": {
              "url": "/api.php/provide/vod/from/hnm3u8/at/xml/",
              "method": "GET",
              "query": {
                "ac": "detail",
                "wd": "{{keyword}}",
                "pg": "{{page}}"
              }
            },
            "response": {
              "format": "xml",
              "engine": "jsonpath",
              "list": "$.list.video[*]",
              "fields": {
                "id": "id",
                "title": "name",
                "cover": "pic",
                "subtitle": "note",
                "category": "type"
              },
              "xmlMode": "toObject"
            },
            "update": {
              "page": {
                "add": [
                  "page",
                  1
                ]
              }
            },
            "open": "ui.detail"
          }
        },
        "ui.detail": {
          "info": {
            "request": {
              "url": "/api.php/provide/vod/from/hnm3u8/at/xml/",
              "method": "GET",
              "query": {
                "ac": "detail",
                "ids": "{{ui.search.list.id}}"
              }
            },
            "response": {
              "format": "xml",
              "engine": "jsonpath",
              "item": "$.list.video[0]||$.list.video",
              "fields": {
                "title": "name",
                "cover": "pic",
                "category": "type",
                "year": "year",
                "area": "area",
                "director": "director",
                "actor": "actor",
                "summary": "des",
                "subtitle": "note"
              },
              "xmlMode": "toObject"
            }
          },
          "episodes": {
            "request": {
              "reuse": "info"
            },
            "response": {
              "format": "xml",
              "engine": "embeddedPlaylist",
              "lineField": "_play_from",
              "itemsField": "_play_url",
              "lineSplit": "$$$",
              "itemSplit": "#",
              "pairRegex": "([^$#]+)\\$([^$#]+)",
              "fields": {
                "title": "itemName",
                "url": "itemUrl"
              },
              "xmlMode": "toObject"
            }
          }
        },
        "ui.video.play": {
          "content": {
            "response": {
              "format": "text"
            },
            "output": {
              "kind": "media",
              "field": "{{ui.detail.episodes.url}}"
            }
          }
        }
      }
    },
